            <stringProp name="script"><![CDATA[
import groovy.json.JsonSlurper

def reject = { String message ->
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(message)
}

def responseCode = prev.getResponseCode()
if (responseCode == '401') {
    reject('Authentication failed or token expired (HTTP 401)')
    return
}
if (responseCode == '403') {
    reject('Role authorization denied (HTTP 403)')
    return
}
if (responseCode != '200') {
    reject('Expected HTTP 200')
    return
}
def payload
try {
    payload = new JsonSlurper().parseText(prev.getResponseDataAsString())
} catch (Exception ignored) {
    reject('Response is not valid JSON')
    return
}
if (!(payload instanceof Map) || !payload.containsKey('data')) {
    reject('Missing top-level data envelope')
    return
}
def data = payload.data
def label = prev.getSampleLabel()
def expectedRole = vars.get('expected_role')
if (label.contains('/users/me')) {
    if (!(data instanceof Map) || !(data.id instanceof Number) || data.role != expectedRole) {
        reject('Current-user response role or shape mismatch')
    }
} else if (label.contains('/classes/list')) {
    if (!(data instanceof Map) || !(data.data instanceof List) || !(data.total_data instanceof Number)) {
        reject('Class-list pagination envelope mismatch')
    }
} else if (label.contains('/summary')) {
    if (!(data instanceof Map) || !(data.student_id instanceof Number)) {
        reject('Academic-summary response shape mismatch')
    }
} else if (label.contains('/parent/child/profile')) {
    if (!(data instanceof Map)) {
        reject('Child-profile response shape mismatch')
    }
} else if (!(data instanceof List)) {
    reject('Expected an array in data')
}
            ]]></stringProp>
