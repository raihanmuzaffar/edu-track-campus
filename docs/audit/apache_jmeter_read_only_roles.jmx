      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Preflight — validate target and total users" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script"><![CDATA[
import java.net.URI
import java.util.Locale

def fail = { String reason ->
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode('CONFIG')
    SampleResult.setResponseMessage("Preflight blocked: ${reason}")
    SampleResult.setResponseData('No HTTP sampler was run.', 'UTF-8')
    log.error("JMeter preflight blocked: ${reason}")
    ctx.getEngine().stopTest(true)
    throw new IllegalStateException("Preflight blocked: ${reason}")
}

def profile = props.getProperty('profile', 'disabled').trim()
if (!(profile in ['disabled', 'production_smoke', 'staging_load'])) {
    fail('unknown profile')
}

def readUserCount = { String propertyName ->
    try {
        Integer.parseInt(props.getProperty(propertyName, '0'))
    } catch (NumberFormatException ignored) {
        fail('virtual-user count must be an integer')
    }
}

def studentUsers = readUserCount('student_users')
def dosenUsers = readUserCount('dosen_users')
def parentUsers = readUserCount('parent_users')
def totalUsers = studentUsers.toLong() + dosenUsers.toLong() + parentUsers.toLong()
if ([studentUsers, dosenUsers, parentUsers].any { it < 0 }) {
    fail('virtual-user counts cannot be negative')
}
if (totalUsers > 5) {
    fail('total virtual-user limit is 5')
}
if (profile == 'disabled') {
    SampleResult.setResponseCode('LOCAL')
    SampleResult.setResponseMessage('Preflight passed; no HTTP request will run')
    SampleResult.setResponseData('Disabled profile. No HTTP sampler was run.', 'UTF-8')
    return
}
if (totalUsers < 1) {
    fail('active profile requires at least one virtual user')
}
if (profile == 'production_smoke' && totalUsers > 1) {
    fail('production smoke allows one total virtual user')
}

def apiBaseUrl = props.getProperty('api_base_url', '').trim()
def apiUri
try {
    apiUri = new URI(apiBaseUrl)
} catch (Exception ignored) {
    fail('API base URL is invalid')
}
def scheme = apiUri.getScheme()
def host = apiUri.getHost()
if (!scheme || scheme.toLowerCase(Locale.ROOT) != 'https' || !host) {
    fail('active profiles require a valid HTTPS API base URL')
}
if (apiUri.getRawUserInfo() != null || apiUri.getRawQuery() != null || apiUri.getRawFragment() != null) {
    fail('API base URL cannot contain credentials, query, or fragment')
}

def normalizeHost = { String value ->
    value.toLowerCase(Locale.ROOT).replaceFirst(/\.$/, '')
}
def normalizedHost = normalizeHost(host)
def blockedProductionHosts = ['sistemkampus.fs.kg', 'www.sistemkampus.fs.kg', '16.178.252.47'] as Set
if (blockedProductionHosts.contains(normalizedHost) || normalizedHost.endsWith('.sistemkampus.fs.kg')) {
    fail('known production host is blocked')
}

if (profile == 'staging_load') {
    def approvedHost = normalizeHost(props.getProperty('approved_staging_hostname', '').trim())
    if (!approvedHost) {
        fail('approved staging hostname is required')
    }

    def approvedUri
    try {
        approvedUri = new URI('https://' + approvedHost)
    } catch (Exception ignored) {
        fail('approved staging hostname is invalid')
    }
    def approvedUriPath = approvedUri.getPath()
    if (!approvedUri.getHost() ||
        normalizeHost(approvedUri.getHost()) != approvedHost ||
        approvedUri.getPort() != -1 ||
        (approvedUriPath != null && !approvedUriPath.isEmpty()) ||
        approvedUri.getRawUserInfo() != null ||
        approvedUri.getRawQuery() != null ||
        approvedUri.getRawFragment() != null) {
        fail('approved staging value must be a hostname only')
    }
    if (blockedProductionHosts.contains(approvedHost) || approvedHost.endsWith('.sistemkampus.fs.kg')) {
        fail('known production hostname cannot be approved for staging')
    }
    if (normalizedHost != approvedHost) {
        fail('API hostname does not match approved staging hostname')
    }
}

SampleResult.setResponseCode('LOCAL')
SampleResult.setResponseMessage('Preflight passed; target and user limits validated')
SampleResult.setResponseData('No HTTP request was sent by preflight.', 'UTF-8')
          ]]></stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>

      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Mahasiswa — read-only" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__groovy(def profile = props.getProperty('profile', 'disabled'); def users = Integer.parseInt(props.getProperty('student_users', '0')); if (profile == 'production_smoke' &amp;&amp; users &gt; 1) throw new IllegalArgumentException('Production smoke allows at most one student user'); profile in ['production_smoke', 'staging_load'] ? Math.max(0, users) : 0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__groovy(def profile = props.getProperty('profile', 'disabled'); def ramp = Integer.parseInt(props.getProperty('ramp_up_seconds', '10')); if (profile in ['production_smoke', 'staging_load'] &amp;&amp; ramp &lt; 1) throw new IllegalArgumentException('Runnable profiles require at least one second of ramp-up'); if (profile == 'production_smoke' &amp;&amp; ramp &gt; 60) throw new IllegalArgumentException('Production smoke ramp-up cannot exceed 60 seconds'); if (profile == 'staging_load' &amp;&amp; ramp &gt; 3600) throw new IllegalArgumentException('Staging ramp-up cannot exceed 3600 seconds'); Math.max(0, ramp))}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__groovy(def profile = props.getProperty('profile', 'disabled'); def duration = Integer.parseInt(props.getProperty('duration_seconds', '60')); if (profile == 'production_smoke' &amp;&amp; duration &gt; 60) throw new IllegalArgumentException('Production smoke duration cannot exceed 60 seconds'); if (profile == 'staging_load' &amp;&amp; duration &gt; 3600) throw new IllegalArgumentException('Staging run cannot exceed 3600 seconds'); Math.max(1, Math.min(duration, profile == 'production_smoke' ? 60 : 3600)))}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">${__groovy(props.getProperty('profile', 'disabled') == 'staging_load' ? '-1' : '1')}</stringProp>
        </elementProp>
      </ThreadGroup>
