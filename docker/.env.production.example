# Variable contract only; this file is intentionally incomplete and is not
# suitable for docker compose --env-file. Supply values through an approved
# deployment configuration/secret manager.
APP_ENV=production

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=

JWT_SECRET=
JWT_ACCESS_TTL_HOURS=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_TLS=true
REFRESH_TOKEN_TTL_DAYS=

# Empty means browser-origin requests are denied; native mobile requests without
# an Origin header remain allowed. Configure only owner-approved HTTPS origins.
CORS_ALLOWED_ORIGINS=

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
